          {
            "type": "calculated",
            "name": "SalesType",
            "dataType": "string",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": "IF(Sales[Quantity] <=50, \"standard\",IF (Sales[Quantity]>50,\"big\"))"
          },
          {
            "type": "calculated",
            "name": "DiscountType",
            "dataType": "string",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": "IF(Sales[Discount]<0.1,\"standard\", IF(Sales[Discount]=0.1,\"medium\",IF(Sales[Discount]>=0.2,\"big\")))"
          }
        ],
