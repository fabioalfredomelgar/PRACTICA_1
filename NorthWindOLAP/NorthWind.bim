        "measures": [
          {
            "name": "TotalQuantity",
            "expression": " SUM(Sales[Quantity])"
          },
          {
            "name": "TotalNetSales",
            "expression": " SUM(Sales[NetSales])"
          },
          {
            "name": "TotalGrossSales",
            "expression": " SUM(sales[GrossAmount])"
          },
          {
            "name": "TotalQuantityStandard",
            "expression": " CALCULATE(Sales[TotalQuantity],Sales[SalesType]=\"standard\")"
          },
          {
            "name": "TotalQuantityBig",
            "expression": " CALCULATE(Sales[TotalQuantity],Sales[SalesType]=\"big\")"
          },
          {
            "name": "TotalNetSalesStandard",
            "expression": " CALCULATE(Sales[TotalNetSales], Sales[SalesType]=\"standard\")"
          },
          {
            "name": "TotalNetSalesBig",
            "expression": " CALCULATE(Sales[TotalNetSales], Sales[SalesType]=\"big\")"
          },
          {
            "name": "TotalQuantityBigDiscount",
            "expression": " CALCULATE(Sales[TotalQuantity], Sales[DiscountType]=\"big\")"
          },
          {
            "name": "TotalQuantityMediumDiscount",
            "expression": " CALCULATE(Sales[TotalQuantity], Sales[DiscountType]=\"medium\")"
          },
          {
            "name": "TotalQuantityStandardDiscount",
            "expression": " CALCULATE(Sales[TotalQuantity], Sales[DiscountType]=\"standard\")"
          },
          {
            "name": "TotalNetSalesBigDiscount",
            "expression": " CALCULATE(Sales[TotalNetSales], Sales[DiscountType]=\"big\")"
          },
          {
            "name": "TotalNetSalesMediumDiscount",
            "expression": " CALCULATE(Sales[TotalNetSales], Sales[DiscountType]=\"medium\")"
          },
          {
            "name": "TotalNetSalesStandardDiscount",
            "expression": " CALCULATE(Sales[TotalNetSales], Sales[DiscountType]=\"standard\")"
          },
          {
            "name": "TotalOrders",
            "expression": " DISTINCTCOUNT(Sales[OrderID])"
          },
          {
            "name": "TotalOrdersStandard",
            "expression": " CALCULATE(Sales[TotalOrders],Sales[SalesType]=\"standard\")"
          },
          {
            "name": "TotalOrdersBig",
            "expression": " CALCULATE(Sales[TotalOrders],Sales[SalesType]=\"big\")"
          }
        ]
      }
